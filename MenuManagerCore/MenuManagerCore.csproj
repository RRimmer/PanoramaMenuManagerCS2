<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376"/>
        <PackageReference Include="Dapper" Version="2.1.89"/>
        <PackageReference Include="MySqlConnector" Version="2.6.2"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MenuManagerApi\MenuManagerApi.csproj"/>
        <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="CopySqliteNativeRuntimes" AfterTargets="Build">
        <ItemGroup>
            <!-- NuGet 2.1.12 needs GLIBC_2.34. This copy is SQLite 3.49.1 and stops at GLIBC_2.28. -->
            <SqliteLinux Include="$(MSBuildProjectDirectory)\native\linux-x64\libe_sqlite3.so"/>
            <SqliteMusl Include="$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlite3\*\runtimes\linux-musl-x64\native\libe_sqlite3.so"/>
            <SqliteWin Include="$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlite3\*\runtimes\win-x64\native\e_sqlite3.dll"/>
        </ItemGroup>
        <Message Importance="high" Text="SQLite linux: @(SqliteLinux->'%(Identity)', ', ')" />
        <Copy SourceFiles="@(SqliteLinux)" DestinationFolder="$(OutDir)runtimes\linux-x64\native\" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(SqliteMusl)" DestinationFolder="$(OutDir)runtimes\linux-musl-x64\native\" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(SqliteWin)" DestinationFolder="$(OutDir)runtimes\win-x64\native\" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(SqliteLinux)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(SqliteWin)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
    </Target>

</Project>
