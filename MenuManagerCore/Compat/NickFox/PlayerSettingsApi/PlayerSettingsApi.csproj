<Project Sdk="Microsoft.NET.Sdk">

    <!-- Marker only: CS2-SimpleAdmin checks that shared/PlayerSettingsApi/PlayerSettingsApi.dll exists.
         No ISettingsApi inside. Real API: PlayerSettingsCS2 by NickFox. -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AssemblyName>PlayerSettingsApi</AssemblyName>
        <RootNamespace>PlayerSettings</RootNamespace>
        <InformationalVersion>0.0.0-pmm-stub</InformationalVersion>
        <Deterministic>true</Deterministic>
        <DebugType>none</DebugType>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

</Project>
